# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Local Pokémon Showdown server checkout (cloned per README, not vendored)
pokemon-showdown/

# poke-engine Rust source checkout (Phase 5). Cloned + built per
# notes/gotcha-poke-engine-pypi-wheel-is-gen4-not-gen9.md, not vendored -
# the PyPI wheel is a gen4 build and cannot be used.
poke-engine/

# Training artifacts / datasets (large, regenerable)
data/
runs/

# macOS
.DS_Store

# Local secrets (e.g. ladder account credentials for scripts/ladder_ppo.py)
.env.local

# Real-ladder replay HTML saved by scripts/ladder_ppo.py --save-replays
# (diagnostic artifacts, contain real opponents' usernames - not source)
replays/

# Phase 4 C++: CMake build dir (FetchContent'd pybind11/Catch2 sources +
# compiled objects, regenerate via scripts/build_cpp.sh) and the compiled
# extension itself (lands in battle_engine/, also regenerable)
cpp/build/
cpp/.cache/
battle_engine/_native*.so
